---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

export interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, subtitle, date, tags } = post.data;
---

<BaseLayout title={title} description={subtitle || post.body.slice(0, 160)}>
  <a href="/" class="back-link">&larr; Volver al inicio</a>

  <article>
    <header class="article-header">
      <div class="article-date">
        {new Date(date).toLocaleDateString('es-CO', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </div>
      <h1 class="article-title">{title}</h1>
      {subtitle && <p class="article-subtitle">{subtitle}</p>}
      {
        tags && tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag: string) => (
              <a href={`/etiqueta/${tag.toLowerCase().replace(/\s+/g, '-')}`} class="tag">{tag}</a>
            ))}
          </div>
        )
      }
    </header>

    <div class="article-body">
      <slot />
    </div>
  </article>
</BaseLayout>
